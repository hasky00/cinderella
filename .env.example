# bfshare1... for THIS node only. Never the same share on two devices.
CINDERELLA_SHARE=
# bfgroup1... (public, same on every node)
CINDERELLA_GROUP=
# comma separated
CINDERELLA_RELAYS=wss://hasky.chat,wss://relay.primal.net
CINDERELLA_CONFIG=./cinderella.config.json
# rate-limit counters and held events, kept across restarts
CINDERELLA_STATE=./cinderella.state.json
# the node's alert key for veto DMs (NOT a share); created on first start, mode 600
# CINDERELLA_ALERT_KEY=./cinderella.alert.key
