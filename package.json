{
  "name": "cinderella",
  "version": "0.0.1",
  "description": "Policy-aware threshold signing for Nostr, built on FROSTR/bifrost",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/node.ts",
    "test": "tsx src/policy.test.ts && tsx src/e2e.test.ts && tsx src/restart.test.ts && tsx src/feed.test.ts && tsx src/veto.test.ts",
    "test:unit": "tsx src/policy.test.ts",
    "test:e2e": "tsx src/e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "test:restart": "tsx src/restart.test.ts",
    "test:veto": "tsx src/veto.test.ts",
    "test:feed": "tsx src/feed.test.ts"
  },
  "dependencies": {
    "@frostr/bifrost": "2.0.2",
    "@noble/hashes": "^1.4.0",
    "nostr-tools": "^2.17.0"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@types/node": "^26.5.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "ws": "^8.21.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
